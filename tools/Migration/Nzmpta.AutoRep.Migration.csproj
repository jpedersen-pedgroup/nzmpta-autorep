<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoRep O1 data-migration tool ("autorep-migrate").
    Standalone console exe that migrates the legacy AutoRep SQL database (source) into the new
    EF Core schema (target). References Autorep.Web only to reuse AutorepDbContext + the entities;
    it is NOT wired into the web request path. See tools/Migration/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nzmpta.AutoRep.Migration</RootNamespace>
    <AssemblyName>autorep-migrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the web app's EF Core DbContext + domain entities (target side). -->
    <ProjectReference Include="..\..\src\Autorep.Web\Autorep.Web.csproj" />
  </ItemGroup>

</Project>
