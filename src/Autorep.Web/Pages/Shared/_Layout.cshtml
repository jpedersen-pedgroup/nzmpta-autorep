@inject Microsoft.AspNetCore.Identity.UserManager<Autorep.Web.Domain.Entities.Tester> UserManager
@{
    var userInitials = "";
    if (User.Identity?.Name is { } name && name.Length > 0)
    {
        userInitials = name.Substring(0, 1).ToUpperInvariant();
    }
    var isTester = User.IsInRole("Tester");
    var isAdmin = User.IsInRole("SuperAdministrator") || User.IsInRole("CompanyAdministrator");
    var isSuperAdmin = User.IsInRole("SuperAdministrator");

    // Licence reminder banner: Testers within 180 days of expiry, prominent inside 60 days.
    DateOnly? expiry = null;
    if (User.Identity?.IsAuthenticated == true && isTester)
    {
        var u = await UserManager.GetUserAsync(User);
        expiry = u?.LicenceExpiryDate;
    }
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    int? daysToExpiry = expiry.HasValue
        ? expiry.Value.DayNumber - today.DayNumber
        : (int?)null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "AutoRep") · NZMPTA AutoRep</title>

    <!-- Font Awesome: vendored Free webfonts as the offline baseline; the Pro kit upgrades the
         same fa-solid classes when it loads (the service worker caches it for offline reuse). -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/46ebb87e5d.js" crossorigin="anonymous" defer></script>

    @* PWA icons, theme colour, brand fonts, iOS launch screens, and site.css. *@
    <partial name="_BrandHead" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="app-header">
            <div class="app-header__inner">
            <a class="app-header__brand" asp-page="/Index">
                @* Decorative: the adjacent "AutoRep App" text already labels this home link. *@
                <img class="app-header__brand-logo" src="~/img/logo-mpnz-white.svg" alt="" width="88" height="30" />
                <span>AutoRep App</span>
            </a>
            <button type="button" class="app-header__burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <div class="app-header__menu">
                <nav class="app-header__nav">
                    @if (isTester)
                    {
                        <a asp-page="/App/Index">Home</a>
                        <a asp-page="/App/Tests/Index">My tests</a>
                        <a asp-page="/App/Tests/New">New test</a>
                    }
                    @if (isAdmin)
                    {
                        <a asp-page="/Admin/Index">Home</a>
                        <a asp-page="/Admin/Tests/Index">All tests</a>
                        <a asp-page="/Admin/Farms/Index">Farms</a>
                        @if (isSuperAdmin)
                        {
                            <a asp-page="/Admin/Testers/Index">Testers</a>
                            <a asp-page="/Admin/Companies/Index">Companies</a>
                            <a asp-page="/Admin/Regions/Index">Regions</a>
                            <a asp-page="/Admin/MilkSupplyCompanies/Index">Milk companies</a>
                        }
                    }
                </nav>
                <div class="app-header__user">
                    <a class="app-header__user-name" asp-page="/Account/Manage" style="text-decoration:none">
                        <span class="app-header__user-avatar">@userInitials</span>
                        <span>@User.Identity?.Name</span>
                    </a>
                    <form method="post" asp-page="/Account/Logout" style="margin:0">
                        <button type="submit" class="btn btn--ghost">Sign out</button>
                    </form>
                </div>
            </div>
            </div>
        </header>

        @if (daysToExpiry.HasValue)
        {
            if (daysToExpiry <= 0)
            {
                <div class="licence-banner licence-banner--urgent">
                    <strong>Your tester licence has expired.</strong>
                    You can finish syncing existing tests but won't be able to sign in again until renewed. Contact NZMPTA.
                </div>
            }
            else if (daysToExpiry <= 60)
            {
                <div class="licence-banner licence-banner--urgent">
                    <strong>Your tester licence expires in @daysToExpiry day@(daysToExpiry == 1 ? "" : "s")</strong>
                    (@expiry?.ToString("dd MMM yyyy")). Contact NZMPTA to renew.
                </div>
            }
            else if (daysToExpiry <= 180)
            {
                <div class="licence-banner">
                    Your tester licence expires on @expiry?.ToString("dd MMM yyyy") (in @daysToExpiry days). Plan your renewal.
                </div>
            }
        }
    }
    <main>
        @RenderBody()
    </main>
    <footer class="app-footer">
        &copy; 2026 NZMPTA · Built by Pedersen Group
    </footer>

    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
    <script>
        (function () {
            var b = document.getElementById('nav-burger');
            var header = document.querySelector('.app-header');
            if (b && header) {
                b.addEventListener('click', function () {
                    var open = header.classList.toggle('app-header--open');
                    b.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            }
        })();
    </script>
    <script>
        // Client-side list filter: an <input data-table-filter="tableId"> hides non-matching
        // rows of #tableId as you type, and toggles an optional [data-table-empty="tableId"].
        (function () {
            document.querySelectorAll('input[data-table-filter]').forEach(function (input) {
                var id = input.getAttribute('data-table-filter');
                var table = document.getElementById(id);
                if (!table) return;
                var empty = document.querySelector('[data-table-empty="' + id + '"]');
                input.addEventListener('input', function () {
                    var q = input.value.trim().toLowerCase();
                    var shown = 0;
                    table.querySelectorAll('tbody tr').forEach(function (row) {
                        var match = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
                        row.style.display = match ? '' : 'none';
                        if (match) shown++;
                    });
                    if (empty) empty.hidden = shown !== 0;
                });
            });
        })();
    </script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>window.__autorepTesterId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
