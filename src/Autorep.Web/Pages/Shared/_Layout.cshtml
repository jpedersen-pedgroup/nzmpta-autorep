@inject Microsoft.AspNetCore.Identity.UserManager<Autorep.Web.Domain.Entities.Tester> UserManager
@{
    var userInitials = "";
    if (User.Identity?.Name is { } name && name.Length > 0)
    {
        userInitials = name.Substring(0, 1).ToUpperInvariant();
    }
    var isTester = User.IsInRole("Tester");
    var isAdmin = User.IsInRole("SuperAdministrator") || User.IsInRole("CompanyAdministrator");
    var isSuperAdmin = User.IsInRole("SuperAdministrator");

    // Licence reminder banner: Testers within 180 days of expiry, prominent inside 60 days.
    DateOnly? expiry = null;
    if (User.Identity?.IsAuthenticated == true && isTester)
    {
        var u = await UserManager.GetUserAsync(User);
        expiry = u?.LicenceExpiryDate;
    }
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    int? daysToExpiry = expiry.HasValue
        ? expiry.Value.DayNumber - today.DayNumber
        : (int?)null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "AutoRep") · NZMPTA AutoRep</title>

    <!-- PWA -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/icons/icon.svg" />
    <meta name="theme-color" content="#0a2540" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="AutoRep" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="app-header">
            <a class="app-header__brand" asp-page="/Index">
                <span class="app-header__brand-mark">AR</span>
                <span>NZMPTA AutoRep</span>
            </a>
            <nav class="app-header__nav">
                @if (isTester)
                {
                    <a asp-page="/App/Index">Home</a>
                    <a asp-page="/App/Tests/Index">My tests</a>
                    <a asp-page="/App/Tests/New">New test</a>
                }
                @if (isAdmin)
                {
                    <a asp-page="/Admin/Index">Home</a>
                    <a asp-page="/Admin/Tests/Index">All tests</a>
                    <a asp-page="/Admin/Farms/Index">Farms</a>
                    @if (isSuperAdmin)
                    {
                        <a asp-page="/Admin/Testers/Index">Testers</a>
                        <a asp-page="/Admin/Companies/Index">Companies</a>
                        <a asp-page="/Admin/Regions/Index">Regions</a>
                        <a asp-page="/Admin/MilkSupplyCompanies/Index">Milk companies</a>
                    }
                }
            </nav>
            <div class="app-header__user">
                <a class="app-header__user-name" asp-page="/Account/Manage" style="text-decoration:none">
                    <span class="app-header__user-avatar">@userInitials</span>
                    <span>@User.Identity?.Name</span>
                </a>
                <form method="post" asp-page="/Account/Logout" style="margin:0">
                    <button type="submit" class="btn btn--ghost">Sign out</button>
                </form>
            </div>
        </header>

        @if (daysToExpiry.HasValue)
        {
            if (daysToExpiry <= 0)
            {
                <div class="licence-banner licence-banner--urgent">
                    <strong>Your tester licence has expired.</strong>
                    You can finish syncing existing tests but won't be able to sign in again until renewed. Contact NZMPTA.
                </div>
            }
            else if (daysToExpiry <= 60)
            {
                <div class="licence-banner licence-banner--urgent">
                    <strong>Your tester licence expires in @daysToExpiry day@(daysToExpiry == 1 ? "" : "s")</strong>
                    (@expiry?.ToString("dd MMM yyyy")). Contact NZMPTA to renew.
                </div>
            }
            else if (daysToExpiry <= 180)
            {
                <div class="licence-banner">
                    Your tester licence expires on @expiry?.ToString("dd MMM yyyy") (in @daysToExpiry days). Plan your renewal.
                </div>
            }
        }
    }
    <main>
        @RenderBody()
    </main>
    <footer class="app-footer">
        &copy; 2026 NZMPTA · Built by Pedersen Group
    </footer>

    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
