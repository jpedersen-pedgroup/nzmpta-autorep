@page
@model Autorep.Web.Pages.App.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="welcome">
    <h1>Welcome back</h1>
    <p>Pick up where you left off, or start a fresh test on a new farm.</p>
</section>

<div class="tile-grid">
    <a class="tile" asp-page="/App/Tests/New">
        <div class="tile__icon"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i></div>
        <div class="tile__title">Start a new test</div>
        <div class="tile__desc">Begin a fresh machine test at a farm.</div>
    </a>
    <a class="tile" asp-page="/App/Tests/Index">
        <div class="tile__icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></div>
        <div class="tile__title">My tests</div>
        <div class="tile__desc">View tests you've created and synced.</div>
    </a>
    <a class="tile" asp-page="/App/Tests/Company">
        <div class="tile__icon"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
        <div class="tile__title">Company tests</div>
        <div class="tile__desc">Read completed tests from everyone at your company. Needs a connection.</div>
    </a>
</div>
