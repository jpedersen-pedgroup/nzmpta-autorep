@page
@model Autorep.Web.Pages.App.Tests.IndexModel
@{
    ViewData["Title"] = "My tests";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>My tests</h1>
        <p>Machine tests you've created.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn" asp-page="/App/Tests/New">+ New test</a>
    </div>
</div>

@if (!Model.Tests.Any())
{
    <div class="empty">
        <div class="empty__title">No tests yet</div>
        <p class="empty__text">Start your first machine test to begin building your testing history.</p>
        <a class="btn" asp-page="/App/Tests/New">Start a new test</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Farm</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tests)
                {
                    <tr>
                        <td>@t.Farm?.Name</td>
                        <td class="td-muted">@t.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>
                            @if (t.MarkedCompleteAt is null)
                            {
                                <span class="badge badge--warning">In progress</span>
                            }
                            else
                            {
                                <span class="badge badge--success">Complete</span>
                            }
                        </td>
                        <td class="td-muted">@t.Notes</td>
                        <td class="td-actions">
                            @if (t.MarkedCompleteAt is null)
                            {
                                <a class="btn btn--secondary btn--sm" asp-page="/App/Tests/Wizard" asp-route-id="@t.Id">Continue</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn--secondary btn--sm" disabled
                                        title="Downloads the Final Report — the report generator (M4) will regenerate it on-device from the test data. Coming soon.">⬇ PDF</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
