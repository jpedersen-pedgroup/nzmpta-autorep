@page
@model Autorep.Web.Pages.App.Tests.NewModel
@{
    ViewData["Title"] = "New test";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>New machine test</h1>
        <p>Choose the farm, or add a new one.</p>
    </div>
</div>

<div class="card" style="max-width:640px">
    <form method="post">
        <div class="form-field">
            <label for="farm-search">Farm</label>
            <input type="hidden" asp-for="Input.FarmId" id="farm-id" />
            <div class="autocomplete">
                <input type="text" id="farm-search" autocomplete="off" placeholder="Type to search your farms…" />
                <div id="farm-menu" class="autocomplete-menu" hidden></div>
            </div>
            <p class="form-field__hint">Shows farms your company has set up or tested. Not listed? Add a new one.</p>
            <div style="margin-top:var(--space-3)">
                <button type="button" class="btn btn--add" id="new-farm-btn">＋ Add a new farm</button>
            </div>
            <div id="farm-logo-wrap" style="margin-top:var(--space-3);display:none">
                <span style="font-size:0.8125rem;color:var(--text-muted)">Milk supply company</span>
                <img id="farm-logo" src="" alt="Milk supply company logo" style="display:block;max-height:48px;max-width:160px;margin-top:4px" />
            </div>
        </div>

        @if (Model.Errors.Any())
        {
            <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
        }
        <div class="form-actions">
            <button type="submit" class="btn">Start test</button>
            <a class="btn btn--secondary" asp-page="/App/Tests/Index">Cancel</a>
        </div>
    </form>
</div>

<div class="modal-overlay" id="farm-modal">
    <div class="modal modal--wide">
        <div class="modal__title">Add a new farm</div>
        <div id="farm-modal-errors"></div>
        <div class="form-grid">
            <div class="form-field form-field--full"><label for="nf-name">Farm name</label><input id="nf-name" type="text" /></div>
            <div class="form-field"><label for="nf-supply">Supply number</label><input id="nf-supply" type="text" /></div>
            <div class="form-field">
                <label for="nf-milkco">Milk supply company</label>
                <select id="nf-milkco">
                    <option value="">— Not set —</option>
                    @foreach (var c in Model.MilkCompanyOptions) { <option value="@c.Value">@c.Text</option> }
                </select>
            </div>
            <div class="form-field form-field--full">
                <label for="nf-region">Region</label>
                <select id="nf-region">
                    <option value="">— Not set —</option>
                    @foreach (var grp in Model.RegionOptions.GroupBy(o => o.Group?.Name))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var o in grp) { <option value="@o.Value">@o.Text</option> }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="form-field form-field--full"><label for="nf-addr1">Address line 1</label><input id="nf-addr1" type="text" /></div>
            <div class="form-field form-field--full"><label for="nf-addr2">Address line 2</label><input id="nf-addr2" type="text" /></div>
            <div class="form-field"><label for="nf-town">Town / city</label><input id="nf-town" type="text" /></div>
            <div class="form-field"><label for="nf-postcode">Post code</label><input id="nf-postcode" type="text" /></div>
            <div class="form-field"><label for="nf-rapid">RAPID number</label><input id="nf-rapid" type="text" /></div>
            <div class="form-field"><label for="nf-farmer">Farmer name</label><input id="nf-farmer" type="text" /></div>
            <div class="form-field"><label for="nf-phone">Phone</label><input id="nf-phone" type="text" /></div>
            <div class="form-field"><label for="nf-email">Email</label><input id="nf-email" type="email" /></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.CollectionNotice))
        {
            <p class="privacy-notice"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> @Model.CollectionNotice</p>
        }
        @if (!User.IsInRole("CompanyAdministrator") && !User.IsInRole("SuperAdministrator"))
        {
            <p class="form-field__hint">
                New farms are flagged for your Company Administrator to review — you can start
                testing straight away.
            </p>
        }
        <div class="form-actions">
            <button type="button" class="btn" id="nf-create">Add farm</button>
            <button type="button" class="btn btn--secondary" id="nf-cancel">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var farms = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Farms.Select(f => new { id = f.Id, name = f.Name, milkco = f.MilkCompanyId })));
    var search = document.getElementById('farm-search');
    var hidden = document.getElementById('farm-id');
    var menu = document.getElementById('farm-menu');
    var logoWrap = document.getElementById('farm-logo-wrap');
    var logo = document.getElementById('farm-logo');
    var modal = document.getElementById('farm-modal');
    var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
    var token = tokenEl ? tokenEl.value : '';
    var current = [], active = -1;

    function showLogo(milkco) {
        if (milkco) {
            logo.onerror = function () { logoWrap.style.display = 'none'; };
            logo.src = '/api/milk-companies/' + milkco + '/logo';
            logoWrap.style.display = 'block';
        } else {
            logoWrap.style.display = 'none';
        }
    }
    function hide() { menu.hidden = true; menu.innerHTML = ''; current = []; active = -1; }
    function pick(f) { hidden.value = f.id; search.value = f.name; showLogo(f.milkco); hide(); }
    function render(list) {
        current = list; menu.innerHTML = '';
        if (!list.length) {
            menu.innerHTML = '<div class="autocomplete-menu__empty">No matching farms — add a new one below.</div>';
            menu.hidden = false; return;
        }
        list.forEach(function (f, i) {
            var b = document.createElement('button');
            b.type = 'button'; b.textContent = f.name;
            if (i === active) b.className = 'is-active';
            b.addEventListener('mousedown', function (e) { e.preventDefault(); pick(f); });
            menu.appendChild(b);
        });
        menu.hidden = false;
    }
    function filter() {
        var q = search.value.trim().toLowerCase();
        var list = (q === '' ? farms : farms.filter(function (f) { return f.name.toLowerCase().indexOf(q) !== -1; })).slice(0, 50);
        active = -1; render(list);
    }
    search.addEventListener('input', function () { hidden.value = ''; showLogo(null); filter(); });
    search.addEventListener('focus', filter);
    search.addEventListener('keydown', function (e) {
        if (menu.hidden) return;
        if (e.key === 'ArrowDown') { active = Math.min(active + 1, current.length - 1); render(current); e.preventDefault(); }
        else if (e.key === 'ArrowUp') { active = Math.max(active - 1, 0); render(current); e.preventDefault(); }
        else if (e.key === 'Enter') { if (active >= 0) { pick(current[active]); e.preventDefault(); } }
        else if (e.key === 'Escape') { hide(); }
    });
    document.addEventListener('click', function (e) { if (!menu.contains(e.target) && e.target !== search) hide(); });
    // Forgiving submit: if they typed an exact farm name but didn't click a suggestion, resolve it.
    var form = search.closest('form');
    if (form) form.addEventListener('submit', function () {
        if (!hidden.value) {
            var q = search.value.trim().toLowerCase();
            var match = farms.filter(function (f) { return f.name.toLowerCase() === q; })[0];
            if (match) hidden.value = match.id;
        }
    });

    // Add-a-farm modal.
    document.getElementById('new-farm-btn').addEventListener('click', function () { modal.classList.add('open'); });
    document.getElementById('nf-cancel').addEventListener('click', function () { modal.classList.remove('open'); });
    modal.addEventListener('click', function (e) { if (e.target === modal) modal.classList.remove('open'); });
    function val(id) { var v = document.getElementById(id).value.trim(); return v === '' ? null : v; }
    document.getElementById('nf-create').addEventListener('click', function () {
        var errEl = document.getElementById('farm-modal-errors');
        errEl.innerHTML = '';
        var payload = {
            name: val('nf-name'), supplyNumber: val('nf-supply'),
            milkSupplyCompanyId: val('nf-milkco'), regionId: val('nf-region'),
            addressLine1: val('nf-addr1'), addressLine2: val('nf-addr2'),
            town: val('nf-town'), postCode: val('nf-postcode'), rapidNumber: val('nf-rapid'),
            farmerName: val('nf-farmer'), contactPhone: val('nf-phone'), contactEmail: val('nf-email')
        };
        if (!payload.name) { errEl.innerHTML = '<div class="alert alert--danger">Farm name is required.</div>'; return; }
        fetch('?handler=CreateFarm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload)
        }).then(function (r) { return r.ok ? r.json() : r.json().then(function (e) { throw e; }); })
          .then(function (farm) {
              var f = { id: farm.id, name: farm.name, milkco: farm.milkCompanyId || null };
              farms.push(f);
              pick(f);
              modal.classList.remove('open');
          })
          .catch(function (e) {
              errEl.innerHTML = '<div class="alert alert--danger">' + (e && e.error ? e.error : 'Could not add farm.') + '</div>';
          });
    });
})();
</script>
}
