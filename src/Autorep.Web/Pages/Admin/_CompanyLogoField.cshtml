@model Autorep.Web.Pages.Admin.CompanyLogoField
@* The testing company's report logo. The host form must be enctype="multipart/form-data". *@
<div class="form-field">
    <label for="Input_Logo">Report logo</label>
    @if (Model.HasLogo)
    {
        <div style="margin-bottom:var(--space-2)">
            <img src="/api/testing-companies/@Model.CompanyId/logo?v=@Model.Version" alt="@Model.CompanyName logo"
                 style="max-height:64px;max-width:220px;border:1px solid var(--border);border-radius:var(--radius);padding:4px;background:#fff" />
        </div>
        @if (!Model.Printable)
        {
            <div class="alert alert--warning">
                This logo came across from the old system in a format the report can't print, so reports
                currently go out without it. Upload a PNG or JPEG version to replace it.
            </div>
        }
        <label class="form-check" style="margin-bottom:var(--space-2)">
            <input type="checkbox" id="Input_RemoveLogo" name="Input.RemoveLogo" value="true" /> Remove current logo
        </label>
    }
    <input type="file" id="Input_Logo" name="Input.Logo" accept="image/png,image/jpeg" />
    <div class="form-field__hint">
        Upload to @(Model.HasLogo ? "replace" : "add") the logo printed at the top of every Test Summary report.
        PNG or JPEG, up to 1 MB. Testers' devices pick up the change the next time they sync.
    </div>
</div>
