@page "{id:guid}"
@model Autorep.Web.Pages.Admin.Equipment.EditModel
@{
    ViewData["Title"] = "Edit equipment item";
    var hasBrand = Autorep.Web.Domain.Entities.EquipmentItem.HasBrand(Model.Type);
    var hasSpec = Autorep.Web.Domain.Entities.OemSpecs.HasSpec(Model.Type);
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>Edit @Autorep.Web.Pages.Admin.Equipment.IndexModel.TitleFor(Model.Type).TrimEnd('s').ToLowerInvariant()</h1>
        <p>OEM Specs · @Autorep.Web.Pages.Admin.Equipment.IndexModel.TitleFor(Model.Type)</p>
    </div>
</div>

@if (Model.Errors.Any())
{
    <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}
@if (Model.Message is not null)
{
    <div class="alert alert--success">@Model.Message</div>
}

<div class="card" style="max-width:760px">
    <form method="post">
        <div class="form-grid">
            @if (hasBrand)
            {
                <div class="form-field">
                    <label asp-for="Brand">Brand</label>
                    <input asp-for="Brand" type="text" />
                </div>
            }
            <div class="form-field form-field--full">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" type="text" />
            </div>
        </div>
        @if (hasSpec)
        {
            <partial name="_SpecFields" for="Spec" view-data='new ViewDataDictionary(ViewData) { ["SpecType"] = Model.Type }' />
        }
        <div class="form-actions">
            <button type="submit" class="btn">Save</button>
            <button type="submit" class="btn btn--secondary" asp-page-handler="ToggleActive">
                @(Model.IsActive ? "Deactivate" : "Reactivate")
            </button>
            <a class="btn btn--secondary" asp-page="/Admin/Equipment/Index">Back</a>
            <button type="submit" class="btn btn--danger-soft" asp-page-handler="Delete"
                    onclick="return confirm('Delete this item? Prefer Deactivate if it may appear on historical tests.');"
                    style="margin-left:auto">
                Delete
            </button>
        </div>
    </form>
</div>

@if (hasSpec)
{
    <div class="card" style="max-width:760px; margin-top:1.5rem">
        <h2 class="card__title">Spec history</h2>
        <div class="form-field__hint">
            A test is judged against the spec in effect on the day it was started. Specs already in effect
            don't change; a scheduled one can be changed or removed until its day.
        </div>
        @if (Model.History.Count == 0)
        {
            <p class="td-muted">No spec yet: tests of this model get no spec verdict.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Applies from</th><th>Spec</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.History)
                        {
                            <tr>
                                <td>@(v.EffectiveFrom?.ToString("d MMM yyyy") ?? "The start (legacy AutoRep)")</td>
                                <td>@(v.Summary ?? "No spec")</td>
                                <td>
                                    @if (v.InEffect) { <span class="badge badge--success">In effect</span> }
                                    else if (v.Scheduled) { <span class="badge badge--info">Scheduled</span> }
                                    else { <span class="badge">Earlier</span> }
                                </td>
                                <td>
                                    @if (v.Scheduled || v.EffectiveFrom == Model.Today)
                                    {
                                        <a class="btn btn--secondary" asp-page="/Admin/Equipment/Edit" asp-route-id="@Model.Id"
                                           asp-route-from="@v.EffectiveFrom?.ToString("yyyy-MM-dd")">Change</a>
                                    }
                                    @if (v.Scheduled)
                                    {
                                        <form method="post" asp-page-handler="DeleteVersion" asp-route-id="@Model.Id" style="display:inline"
                                              onsubmit="return confirm('Remove the spec scheduled for @v.EffectiveFrom?.ToString("d MMM yyyy")?');">
                                            <input type="hidden" name="versionId" value="@v.Id" />
                                            <button type="submit" class="btn btn--danger-soft">Remove</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
