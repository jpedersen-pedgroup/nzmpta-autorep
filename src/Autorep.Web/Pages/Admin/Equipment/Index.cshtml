@page
@model Autorep.Web.Pages.Admin.Equipment.IndexModel
@{
    ViewData["Title"] = "OEM Specs";

    async Task RowsTable(IEnumerable<Autorep.Web.Pages.Admin.Equipment.IndexModel.Row> rows, bool hasSpec)
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Name</th>@if (hasSpec) { <th>OEM spec</th> }<th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td>@r.Name</td>
                            @if (hasSpec)
                            {
                                <td>
                                    @if (r.Spec is not null) { @r.Spec }
                                    else { <span class="badge badge--warning">No spec</span> }
                                    @if (r.NextChange is { } next) { <span class="badge badge--info">Changes @next.ToString("d MMM yyyy")</span> }
                                </td>
                            }
                            <td>
                                @if (r.IsActive) { <span class="badge badge--success">Active</span> }
                                else { <span class="badge">Deactivated</span> }
                            </td>
                            <td><a class="btn btn--secondary" asp-page="/Admin/Equipment/Edit" asp-route-id="@r.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>OEM Specs</h1>
        <p>
            The equipment behind the Machine Configuration dropdowns — shells, liners, pulsator models,
            vacuum and releaser pumps, regulator types, milkline sizes and pulsator configurations — and
            the OEM specs tests are judged against: each pulsator model's rate and ratio bands, and each
            vacuum pump's air flow. Changes sync to testers' devices the next time they're online. A spec
            change applies from a date you choose: tests started on or after it are judged against it,
            and devices switch over on the day. Finished tests keep the specs they were judged against.
            Deactivate an item to hide it from new tests without affecting historical tests.
        </p>
    </div>
    <div class="page-header__actions">
        <a class="btn" asp-page="/Admin/Equipment/New">+ New item</a>
    </div>
</div>

@foreach (var group in Model.Groups)
{
    <details class="accordion">
        <summary class="accordion__summary">
            <span>@group.Title</span>
            <span class="badge">@group.Rows.Count(r => r.IsActive) active@(group.Rows.Any(r => !r.IsActive) ? $" · {group.Rows.Count(r => !r.IsActive)} deactivated" : "")@(group.ActiveWithoutSpec > 0 ? $" · {group.ActiveWithoutSpec} without a spec" : "")</span>
        </summary>
        @if (group.Brands.Count > 0)
        {
            <div class="accordion__body">
                @foreach (var brand in group.Brands)
                {
                    <details class="accordion accordion--nested">
                        <summary class="accordion__summary">
                            <span>@brand.Title</span>
                            <span class="badge">@brand.Rows.Count(r => r.IsActive) active@(brand.Rows.Any(r => !r.IsActive) ? $" · {brand.Rows.Count(r => !r.IsActive)} deactivated" : "")</span>
                        </summary>
                        @{ await RowsTable(brand.Rows, group.HasSpec); }
                    </details>
                }
            </div>
        }
        else
        {
            await RowsTable(group.Rows, group.HasSpec);
        }
    </details>
}
