@page
@model Autorep.Web.Pages.Admin.Companies.IndexModel
@{
    ViewData["Title"] = "Testing companies";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>Testing companies</h1>
        <p>Companies whose testers use AutoRep.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn" asp-page="/Admin/Companies/New">+ New company</a>
    </div>
</div>

@if (!Model.Companies.Any())
{
    <div class="empty">
        <div class="empty__title">No companies yet</div>
        <p class="empty__text">Add your first testing company to start onboarding testers.</p>
        <a class="btn" asp-page="/Admin/Companies/New">Add a company</a>
    </div>
}
else
{
    <div class="list-search">
        <input type="search" data-table-filter="companies-table" placeholder="Search companies…" aria-label="Search companies" />
    </div>
    <div class="table-wrap table-wrap--scroll">
        <table class="table" id="companies-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Testers</th>
                    <th>Tests</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Companies)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>
                            @if (c.IsActive) { <span class="badge badge--success">Active</span> }
                            else { <span class="badge">Deactivated</span> }
                        </td>
                        <td>
                            @if (c.TesterCount > 0)
                            { <a class="count-link" asp-page="/Admin/Testers/Index" asp-route-companyId="@c.Id" title="View this company's testers">@c.TesterCount</a> }
                            else { @c.TesterCount }
                        </td>
                        <td>
                            @if (c.TestCount > 0)
                            { <a class="count-link" asp-page="/Admin/Tests/Index" asp-route-companyId="@c.Id" title="View this company's tests">@c.TestCount</a> }
                            else { @c.TestCount }
                        </td>
                        <td class="td-muted">@c.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td><a class="btn btn--secondary" asp-page="/Admin/Companies/Edit" asp-route-id="@c.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="empty" data-table-empty="companies-table" hidden>
        <div class="empty__title">No matching companies</div>
        <p class="empty__text">Try a different search term.</p>
    </div>
}
