@page "{id:guid}"
@model Autorep.Web.Pages.Admin.Companies.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Input.Name}";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>@Model.Input.Name</h1>
        <p>@Model.TesterCount tester(s) · created @Model.CreatedAt.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--secondary" asp-page="/Admin/Companies/Index">Back</a>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert--success">@Model.Message</div>
}

<div class="card" style="max-width:640px">
    <h2 class="card__title">Details</h2>
    <form method="post">
        <div class="form-field">
            <label asp-for="Input.Name">Name</label>
            <input asp-for="Input.Name" required />
        </div>
        @if (Model.Errors.Any())
        {
            <div class="alert alert--danger">
                <ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul>
            </div>
        }
        <div class="form-actions">
            <button type="submit" class="btn">Save</button>
        </div>
    </form>
</div>

<div class="card" style="max-width:640px">
    <h2 class="card__title">@(Model.IsActive ? "Deactivate" : "Reactivate")</h2>
    <p style="color:var(--text-muted)">
        @if (Model.IsActive)
        { <span>Hides this company from the active list and prevents new tester assignments. Existing data is preserved.</span> }
        else
        { <span>Restores this company to the active list.</span> }
    </p>
    <form method="post" asp-page-handler="ToggleActive">
        <div class="form-actions">
            <button type="submit" class="btn @(Model.IsActive ? "btn--danger" : "")">
                @(Model.IsActive ? "Deactivate" : "Reactivate")
            </button>
        </div>
    </form>
</div>
