@page
@using Autorep.Web.Services
@model Autorep.Web.Pages.Admin.MyCompany.IndexModel
@{
    ViewData["Title"] = "My company";
    var c = Model.Company;
}

@if (c is null)
{
    <div class="page-header">
        <div class="page-header__heading"><h1>My company</h1></div>
    </div>
    <div class="card empty" style="max-width:640px">
        <div class="empty__title">You're not linked to a testing company</div>
        <p>Ask NZMPTA to attach your account to your testing company, then you can manage its report logo here.</p>
    </div>
}
else
{
    var address = string.Join(", ", new[] { c.AddressLine1, c.AddressLine2, c.Town, c.PostCode }.Where(s => !string.IsNullOrWhiteSpace(s)));

    <div class="page-header">
        <div class="page-header__heading">
            <h1>@c.Name</h1>
            <p>@Model.TesterCount tester(s)</p>
        </div>
        <div class="page-header__actions">
            <a class="btn btn--secondary" asp-page="/Admin/Index">Back</a>
        </div>
    </div>

    @if (Model.Message is not null) { <div class="alert alert--success">@Model.Message</div> }

    <div class="card" style="max-width:640px">
        <h2 class="card__title">Report logo</h2>
        <form method="post" enctype="multipart/form-data">
            <div class="form-field">
                <label asp-for="Input.Logo">Logo</label>
                @if (Model.LogoPreview is not null)
                {
                    <div style="margin-bottom:var(--space-2)">
                        <img src="@Model.LogoPreview" alt="@c.Name logo"
                             style="max-height:64px;max-width:220px;border:1px solid var(--border);border-radius:var(--radius);padding:4px;background:#fff" />
                    </div>
                    <label class="form-check" style="margin-bottom:var(--space-2)">
                        <input asp-for="Input.RemoveLogo" type="checkbox" /> Remove current logo
                    </label>
                }
                <input asp-for="Input.Logo" type="file" accept="@LogoImage.Accept" />
                <div class="form-field__hint">
                    Printed on every page of your company's Test Summary reports. Upload to
                    @(Model.LogoPreview is null ? "add" : "replace") the logo. PNG, JPEG or SVG, up to 1 MB.
                    Testers' devices pick up the change the next time they sync.
                </div>
            </div>
            @if (Model.Errors.Any())
            {
                <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
            }
            <div class="form-actions"><button type="submit" class="btn">Save logo</button></div>
        </form>
    </div>

    <div class="card" style="max-width:640px">
        <h2 class="card__title">Details</h2>
        <div class="form-field"><label>Address</label><div>@(address.Length > 0 ? address : "—")</div></div>
        <div class="form-field"><label>Phone</label><div>@(c.Phone ?? "—")</div></div>
        <div class="form-field"><label>Email</label><div>@(c.Email ?? "—")</div></div>
        <div class="form-field__hint">NZMPTA maintains these details — contact them if anything needs changing.</div>
    </div>
}
