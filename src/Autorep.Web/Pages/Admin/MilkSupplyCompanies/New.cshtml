@page
@model Autorep.Web.Pages.Admin.MilkSupplyCompanies.NewModel
@{
    ViewData["Title"] = "New milk supply company";
}

<div class="page-header">
    <div class="page-header__heading"><h1>New milk supply company</h1></div>
    <div class="page-header__actions">
        <a class="btn btn--secondary" asp-page="/Admin/MilkSupplyCompanies/Index">Back</a>
    </div>
</div>

<div class="card" style="max-width:640px">
    <form method="post" enctype="multipart/form-data">
        <div class="form-field">
            <label asp-for="Input.Name">Name</label>
            <input asp-for="Input.Name" required autofocus />
        </div>
        <div class="form-field">
            <label asp-for="Input.Logo">Logo</label>
            <input asp-for="Input.Logo" type="file" accept="image/*" />
            <div class="form-field__hint">PNG, JPG or SVG, up to 1 MB.</div>
        </div>
        <div class="form-field"><label asp-for="Input.AddressLine1">Address line 1</label><input asp-for="Input.AddressLine1" /></div>
        <div class="form-field"><label asp-for="Input.AddressLine2">Address line 2</label><input asp-for="Input.AddressLine2" /></div>
        <div class="form-field"><label asp-for="Input.Town">Town / city</label><input asp-for="Input.Town" /></div>
        <div class="form-field"><label asp-for="Input.PostCode">Post code</label><input asp-for="Input.PostCode" /></div>
        <div class="form-field"><label asp-for="Input.Phone">Phone</label><input asp-for="Input.Phone" /></div>
        <div class="form-field"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email" type="email" /></div>
        @if (Model.Errors.Any())
        {
            <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
        }
        <div class="form-actions"><button type="submit" class="btn">Create</button></div>
    </form>
</div>
