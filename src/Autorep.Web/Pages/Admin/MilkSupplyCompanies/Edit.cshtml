@page "{id:guid}"
@model Autorep.Web.Pages.Admin.MilkSupplyCompanies.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Input.Name}";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>@Model.Input.Name</h1>
        <p>@Model.FarmCount farm(s) supply this processor</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--secondary" asp-page="/Admin/MilkSupplyCompanies/Index">Back</a>
    </div>
</div>

@if (Model.Message is not null) { <div class="alert alert--success">@Model.Message</div> }

<div class="card" style="max-width:640px">
    <h2 class="card__title">Details</h2>
    <form method="post" enctype="multipart/form-data">
        <div class="form-field"><label asp-for="Input.Name">Name</label><input asp-for="Input.Name" required /></div>

        <div class="form-field">
            <label asp-for="Input.Logo">Logo</label>
            @if (Model.HasLogo)
            {
                <div style="margin-bottom:var(--space-2)">
                    <img src="/api/milk-companies/@Model.Id/logo" alt="@Model.Input.Name logo"
                         style="max-height:64px;max-width:220px;border:1px solid var(--border);border-radius:var(--radius);padding:4px;background:#fff" />
                </div>
                <label class="form-check" style="margin-bottom:var(--space-2)">
                    <input asp-for="Input.RemoveLogo" type="checkbox" /> Remove current logo
                </label>
            }
            <input asp-for="Input.Logo" type="file" accept="image/*" />
            <div class="form-field__hint">Upload to @(Model.HasLogo ? "replace" : "add") the logo. PNG, JPG or SVG, up to 1 MB.</div>
        </div>

        <div class="form-field"><label asp-for="Input.AddressLine1">Address line 1</label><input asp-for="Input.AddressLine1" /></div>
        <div class="form-field"><label asp-for="Input.AddressLine2">Address line 2</label><input asp-for="Input.AddressLine2" /></div>
        <div class="form-field"><label asp-for="Input.Town">Town / city</label><input asp-for="Input.Town" /></div>
        <div class="form-field"><label asp-for="Input.PostCode">Post code</label><input asp-for="Input.PostCode" /></div>
        <div class="form-field"><label asp-for="Input.Phone">Phone</label><input asp-for="Input.Phone" /></div>
        <div class="form-field"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email" type="email" /></div>
        @if (Model.Errors.Any())
        {
            <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
        }
        <div class="form-actions"><button type="submit" class="btn">Save</button></div>
    </form>
</div>

<div class="card" style="max-width:640px">
    <h2 class="card__title">@(Model.IsActive ? "Deactivate" : "Reactivate")</h2>
    <p style="color:var(--text-muted)">
        @if (Model.IsActive) { <span>Hides this processor from new Farm pickers. Farms already using it keep it.</span> }
        else { <span>Restores this processor to the picker.</span> }
    </p>
    <form method="post" asp-page-handler="ToggleActive">
        <div class="form-actions">
            <button type="submit" class="btn @(Model.IsActive ? "btn--danger" : "")">@(Model.IsActive ? "Deactivate" : "Reactivate")</button>
        </div>
    </form>
</div>
