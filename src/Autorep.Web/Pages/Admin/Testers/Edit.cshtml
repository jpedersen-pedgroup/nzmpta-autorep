@page "{id}"
@model Autorep.Web.Pages.Admin.Testers.EditModel
@using Autorep.Web.Domain
@{
    ViewData["Title"] = $"Edit {Model.EditingUser?.Email}";
    var isActive = !Model.EditingUser!.LockoutEnd.HasValue || Model.EditingUser.LockoutEnd < DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>@Model.EditingUser?.Email</h1>
        <p>@Model.EditingUser?.DisplayName · @Model.RolesDisplay · @(Model.CompanyName ?? "No company")</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--secondary" asp-page="/Admin/Testers/Index">Back</a>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert--success">@Model.Message</div>
}
@if (Model.Errors.Any())
{
    <div class="alert alert--danger">
        <ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul>
    </div>
}

<div class="card form-tabs-card form-tabs-card--scroll" style="max-width:720px">
    <div class="tabs" id="tester-tabs" role="tablist">
        <button type="button" class="tab is-active" data-panel="tester-panel-details">Details</button>
        <button type="button" class="tab" data-panel="tester-panel-licence">Licence</button>
        <button type="button" class="tab" data-panel="tester-panel-security">Security</button>
        <button type="button" class="tab" data-panel="tester-panel-account">Account</button>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-details">
        <form method="post" asp-page-handler="Details">
            <div class="form-field">
                <label asp-for="Details.DisplayName">Display name</label>
                <input asp-for="Details.DisplayName" required />
            </div>
            <div class="form-field">
                <label asp-for="Details.CertificateNo">Certificate number</label>
                <input asp-for="Details.CertificateNo" maxlength="50" />
                <p class="form-field__hint">NZMPTA accreditation / certificate number, shown on the report sign-off.</p>
            </div>
            <div class="form-field">
                <label>Roles</label>
                <div class="checkbox-group">
                    @foreach (var role in Roles.All)
                    {
                        <label class="form-check">
                            <input type="checkbox" name="Details.SelectedRoles" value="@role"
                                   checked="@(Model.Details.SelectedRoles.Contains(role))" />
                            <span>@Roles.Label(role)</span>
                        </label>
                    }
                </div>
                <p class="form-field__hint">A user can hold more than one role — e.g. a Company Administrator who is also a Tester.</p>
            </div>
            <div class="form-field">
                <label asp-for="Details.TestingCompanyId">Testing company</label>
                <select asp-for="Details.TestingCompanyId" asp-items="Model.Companies">
                    <option value="">— None —</option>
                </select>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save details</button>
            </div>
        </form>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-licence" hidden>
        <form method="post" asp-page-handler="Licence">
            <div class="form-field">
                <label asp-for="LicenceExpiryDate">Licence expiry date</label>
                <input asp-for="LicenceExpiryDate" type="date" />
                <p class="form-field__hint">Leave blank to clear. Testers can't sign in once expired (admins still can).</p>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save licence</button>
            </div>
        </form>

        <h3 class="section-title">Equipment calibration</h3>
        <p style="color:var(--text-muted)">
            Maintained by the tester in the app — expiry dates for their own instruments.
            Approaching (&le; 6 weeks) or expired calibration warns the tester but never blocks testing.
        </p>
        @{
            var calToday = DateOnly.FromDateTime(DateTime.UtcNow);
            var calibration = new (string Label, DateOnly? Date)[]
            {
                ("Air-flow meters", Model.EditingUser?.CalAirFlowMetersExpiry),
                ("Pulsator testers", Model.EditingUser?.CalPulsatorTestersExpiry),
                ("Vacuum gauges", Model.EditingUser?.CalVacuumGaugesExpiry),
            };
        }
        <div class="form-grid">
            @foreach (var (label, date) in calibration)
            {
                <div>
                    <span style="color:var(--text-muted);font-size:0.8125rem">@label</span>
                    <div>
                        @if (date is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @date.Value.ToString("dd MMM yyyy")
                            @if (date.Value < calToday)
                            {
                                <span class="badge badge--danger">expired</span>
                            }
                            else if (date.Value.DayNumber - calToday.DayNumber <= 42)
                            {
                                <span class="badge badge--warning">due soon</span>
                            }
                            else
                            {
                                <span class="badge badge--success">current</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-security" hidden>
        <h3 class="section-title" style="margin-top:0">Password reset</h3>
        <p style="color:var(--text-muted)">Send the user a link to set a new password. Link expires in 1 hour.</p>
        <form method="post" asp-page-handler="ResetPassword">
            <div class="form-actions">
                <button type="submit" class="btn btn--secondary">Send reset email</button>
            </div>
        </form>
        <h3 class="section-title">Force sign out</h3>
        <p style="color:var(--text-muted)">Invalidates all browser sessions and refresh tokens. The user will have to sign in again.</p>
        <form method="post" asp-page-handler="ForceLogout">
            <div class="form-actions">
                <button type="submit" class="btn btn--secondary">Force sign out</button>
            </div>
        </form>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-account" hidden>
        <h3 class="section-title" style="margin-top:0">@(isActive ? "Deactivate account" : "Reactivate account")</h3>
        <p style="color:var(--text-muted)">
            @if (isActive)
            { <span>Prevents sign-in and revokes all sessions. Data is preserved.</span> }
            else
            { <span>Allows this user to sign in again.</span> }
        </p>
        <form method="post" asp-page-handler="ToggleActive">
            <div class="form-actions">
                <button type="submit" class="btn @(isActive ? "btn--danger" : "")">
                    @(isActive ? "Deactivate" : "Reactivate")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Tab switching — each panel holds its own form/handler; the active tab panel
    // scrolls within the card. A validation error reveals its tab.
    (function () {
        var tabs = document.querySelectorAll('#tester-tabs .tab');
        function show(panelId) {
            tabs.forEach(function (t) {
                var on = t.getAttribute('data-panel') === panelId;
                t.classList.toggle('is-active', on);
                document.getElementById(t.getAttribute('data-panel')).hidden = !on;
            });
        }
        tabs.forEach(function (t) {
            t.addEventListener('click', function () { show(t.getAttribute('data-panel')); });
        });
        document.querySelectorAll('.form-tabs-card__panel input, .form-tabs-card__panel select, .form-tabs-card__panel textarea')
            .forEach(function (el) {
                el.addEventListener('invalid', function () {
                    var panel = el.closest('.form-tabs-card__panel');
                    if (panel && panel.hidden) show(panel.id);
                });
            });
    })();
</script>
}
