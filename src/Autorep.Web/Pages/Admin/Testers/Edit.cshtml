@page "{id}"
@model Autorep.Web.Pages.Admin.Testers.EditModel
@using Autorep.Web.Domain
@{
    ViewData["Title"] = $"Edit {Model.EditingUser?.Email}";
    var isActive = !Model.EditingUser!.LockoutEnd.HasValue || Model.EditingUser.LockoutEnd < DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>@Model.EditingUser?.Email</h1>
        <p>@Model.EditingUser?.DisplayName · @Model.RolesDisplay · @(Model.CompanyName ?? "No company")</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--secondary" asp-page="/Admin/Testers/Index">Back</a>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert--success">@Model.Message</div>
}
@if (Model.Errors.Any())
{
    <div class="alert alert--danger">
        <ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul>
    </div>
}

<div class="card form-tabs-card form-tabs-card--scroll" style="max-width:720px">
    <div class="tabs" id="tester-tabs" role="tablist">
        <button type="button" class="tab is-active" data-panel="tester-panel-details">Details</button>
        <button type="button" class="tab" data-panel="tester-panel-licence">Licence</button>
        <button type="button" class="tab" data-panel="tester-panel-security">Security</button>
        <button type="button" class="tab" data-panel="tester-panel-account">Account</button>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-details">
        <form method="post" asp-page-handler="Details">
            <div class="form-field">
                <label asp-for="Details.DisplayName">Display name</label>
                <input asp-for="Details.DisplayName" required />
            </div>
            <div class="form-field">
                <label asp-for="Details.CertificateNo">Certificate number</label>
                <input asp-for="Details.CertificateNo" maxlength="50" />
                <p class="form-field__hint">MPNZ accreditation / certificate number, shown on the report sign-off.</p>
            </div>
            <div class="form-field">
                <label>Roles</label>
                <div class="checkbox-group">
                    @foreach (var role in Roles.All)
                    {
                        <label class="form-check">
                            <input type="checkbox" name="Details.SelectedRoles" value="@role"
                                   checked="@(Model.Details.SelectedRoles.Contains(role))" />
                            <span>@Roles.Label(role)</span>
                        </label>
                    }
                </div>
                <p class="form-field__hint">A user can hold more than one role — e.g. a Company Administrator who is also a Tester.</p>
            </div>
            <div class="form-field">
                <label>Testing company</label>
                <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap">
                    <strong data-current-company>@(Model.CompanyName ?? "None")</strong>
                    <button type="button" class="btn btn--secondary btn--sm" data-open-change-company>
                        @(Model.CompanyName is null ? "Set company" : "Change company")
                    </button>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save details</button>
            </div>
        </form>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-licence" hidden>
        <form method="post" asp-page-handler="Licence">
            <div class="form-field">
                <label asp-for="LicenceExpiryDate">Licence expiry date</label>
                <input asp-for="LicenceExpiryDate" type="date" />
                <p class="form-field__hint">Leave blank to clear. An expired licence doesn't stop the tester using AutoRep: they see a reminder from 60 days before, and their reports show it had expired.</p>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save licence</button>
            </div>
        </form>

        <h3 class="section-title">Equipment calibration</h3>
        <p style="color:var(--text-muted)">
            Maintained by the tester in the app — expiry dates for their own instruments.
            Approaching (&le; 6 weeks) or expired calibration warns the tester but never blocks testing.
        </p>
        @{
            var calToday = NzTime.Today;
            var calibration = new (string Label, DateOnly? Date)[]
            {
                ("Air-flow meters", Model.EditingUser?.CalAirFlowMetersExpiry),
                ("Pulsator testers", Model.EditingUser?.CalPulsatorTestersExpiry),
                ("Vacuum gauges", Model.EditingUser?.CalVacuumGaugesExpiry),
            };
        }
        <div class="form-grid">
            @foreach (var (label, date) in calibration)
            {
                <div>
                    <span style="color:var(--text-muted);font-size:0.8125rem">@label</span>
                    <div>
                        @if (date is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @date.Value.ToString("dd MMM yyyy")
                            @if (date.Value < calToday)
                            {
                                <span class="badge badge--danger">expired</span>
                            }
                            else if (date.Value.DayNumber - calToday.DayNumber <= 42)
                            {
                                <span class="badge badge--warning">due soon</span>
                            }
                            else
                            {
                                <span class="badge badge--success">current</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-security" hidden>
        <h3 class="section-title" style="margin-top:0">Password reset</h3>
        <p style="color:var(--text-muted)">Send the user a link to set a new password. Link expires in 1 hour.</p>
        <form method="post" asp-page-handler="ResetPassword">
            <div class="form-actions">
                <button type="submit" class="btn btn--secondary">Send reset email</button>
            </div>
        </form>
        <h3 class="section-title">Force sign out</h3>
        <p style="color:var(--text-muted)">Invalidates all browser sessions and refresh tokens. The user will have to sign in again.</p>
        <form method="post" asp-page-handler="ForceLogout">
            <div class="form-actions">
                <button type="submit" class="btn btn--secondary">Force sign out</button>
            </div>
        </form>
        <h3 class="section-title">Two-factor authentication</h3>
        @if (Model.EditingUser.TwoFactorEnabled)
        {
            <p style="color:var(--text-muted)">
                <strong>Enabled.</strong> Reset it if they've lost their authenticator app and their recovery codes.
                This signs them out everywhere (within a minute) and forgets their trusted devices; their next sign-in is password only.
                A Super Administrator is then made to set up a new authenticator before they can continue.
            </p>
            <form method="post" asp-page-handler="ResetTwoFactor"
                  onsubmit="return confirm('Reset two-factor for this account? They will be signed out everywhere and their authenticator and recovery codes will stop working.');">
                <div class="form-actions">
                    <button type="submit" class="btn btn--danger">Reset two-factor</button>
                </div>
            </form>
        }
        else
        {
            <p style="color:var(--text-muted)">
                <strong>Not set up.</strong>
                @if (Model.Details.SelectedRoles.Contains(Roles.SuperAdministrator))
                {
                    <text>Required for Super Administrators: they'll be asked to set it up at their next sign-in.</text>
                }
                else
                {
                    <text>Optional for this role; they can set it up under Account settings.</text>
                }
            </p>
        }
    </div>

    <div class="tab-panel form-tabs-card__panel" id="tester-panel-account" hidden>
        <h3 class="section-title" style="margin-top:0">@(isActive ? "Deactivate account" : "Reactivate account")</h3>
        <p style="color:var(--text-muted)">
            @if (isActive)
            { <span>Prevents sign-in and revokes all sessions. Data is preserved.</span> }
            else
            { <span>Allows this user to sign in again.</span> }
        </p>
        <form method="post" asp-page-handler="ToggleActive">
            <div class="form-actions">
                <button type="submit" class="btn @(isActive ? "btn--danger" : "")">
                    @(isActive ? "Deactivate" : "Reactivate")
                </button>
            </div>
        </form>
    </div>
</div>

@* Change company: its own confirmed step, because moving someone has consequences an admin should
   read first. Outside the Details form (forms can't nest). *@
@{
    var person = string.IsNullOrWhiteSpace(Model.EditingUser.DisplayName) ? Model.EditingUser.Email : Model.EditingUser.DisplayName;
    var oldCompany = Model.CompanyName;
}
<div class="modal-overlay" id="change-company" data-change-company>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="change-company-title">
        <div class="modal__title" id="change-company-title">@(oldCompany is null ? "Set" : "Change") @person's company</div>
        <form method="post" asp-page-handler="ChangeCompany">
            <div class="form-field">
                <label for="NewCompanyId">@(oldCompany is null ? "Testing company" : "Move to")</label>
                <select id="NewCompanyId" name="NewCompanyId" required="@Model.NeedsCompany">
                    @if (Model.NeedsCompany)
                    {
                        <option value="">— Choose a company —</option>
                    }
                    else
                    {
                        <option value="">— No company —</option>
                    }
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
                @if (!Model.NeedsCompany)
                {
                    <p class="form-field__hint">Super Administrators can be left without a company.</p>
                }
            </div>
            @if (oldCompany is not null)
            {
                <p><strong>What happens when you move them</strong></p>
                <ul style="list-style:disc;padding-left:1.25rem;margin:0 0 var(--space-4)">
                    <li>The tests they've done for <strong>@oldCompany</strong> stay with it: @oldCompany's administrators still see them, and the new company's don't.</li>
                    <li>The farms they've tested stay with @oldCompany too. The new company gets one of those farms only once @person tests it for them.</li>
                    <li>From now on their new tests are filed under the new company, and they see its farms and its testers' tests.</li>
                    <li>Tests on their device that haven't been sent yet are filed under the new company when they're sent, so ask them to sync first.</li>
                </ul>
            }
            else
            {
                <p>From now on they see the company's farms and its testers' tests, and their new tests are filed under it.</p>
            }
            <div class="form-actions">
                <button type="submit" class="btn">@(oldCompany is null ? "Set company" : "Change company")</button>
                <button type="button" class="btn btn--secondary" data-close-change-company>Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // The Change company dialog: opened from the Details tab, closed by Cancel, Escape or the backdrop.
    (function () {
        var overlay = document.querySelector('[data-change-company]');
        var open = document.querySelector('[data-open-change-company]');
        if (!overlay || !open) return;
        function close() { overlay.classList.remove('open'); open.focus(); }
        open.addEventListener('click', function () {
            overlay.classList.add('open');
            overlay.querySelector('select').focus();
        });
        overlay.querySelector('[data-close-change-company]').addEventListener('click', close);
        overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && overlay.classList.contains('open')) close();
        });
    })();
</script>
<script>
    // Tab switching — each panel holds its own form/handler; the active tab panel
    // scrolls within the card. A validation error reveals its tab.
    (function () {
        var tabs = document.querySelectorAll('#tester-tabs .tab');
        function show(panelId) {
            tabs.forEach(function (t) {
                var on = t.getAttribute('data-panel') === panelId;
                t.classList.toggle('is-active', on);
                document.getElementById(t.getAttribute('data-panel')).hidden = !on;
            });
        }
        tabs.forEach(function (t) {
            t.addEventListener('click', function () { show(t.getAttribute('data-panel')); });
        });
        document.querySelectorAll('.form-tabs-card__panel input, .form-tabs-card__panel select, .form-tabs-card__panel textarea')
            .forEach(function (el) {
                el.addEventListener('invalid', function () {
                    var panel = el.closest('.form-tabs-card__panel');
                    if (panel && panel.hidden) show(panel.id);
                });
            });
    })();
</script>
}
