@page
@model Autorep.Web.Pages.Admin.Standards.IndexModel
@{
    ViewData["Title"] = "Test standards";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>Test standards</h1>
        <p>
            Pass/fail thresholds and formula parameters used by the test wizard, verified against the
            NZMPTA Testing Standards Manual and ISO 6690:2007. Changes sync to testers' devices the
            next time they're online; testers see an in-app notice that the standards have changed.
        </p>
    </div>
    <div class="page-header__actions">
        <a class="btn" asp-page="/Admin/Standards/New">+ New standard</a>
    </div>
</div>

@foreach (var group in Model.Groups)
{
    <h2 style="margin:1.25rem 0 0.5rem">@group.Key</h2>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Standard</th><th>Value</th><th>Key</th><th>Source</th><th>Updated</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in group)
                {
                    <tr>
                        <td>@r.Label</td>
                        <td><strong>@r.Summary</strong></td>
                        <td class="td-muted"><code>@r.Key</code></td>
                        <td class="td-muted">@r.SourceRef</td>
                        <td class="td-muted">@r.UpdatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td><a class="btn btn--secondary" asp-page="/Admin/Standards/Edit" asp-route-id="@r.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="td-muted" style="margin-top:1rem">
    The effective-reserve cluster table, cleaning-reserve formula and atmospheric correction factors
    are ISO/manual-fixed and live in the app; the editable rows above cover every adjustable threshold
    and formula parameter.
</p>
