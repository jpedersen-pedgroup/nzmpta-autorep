@page
@model Autorep.Web.Pages.Admin.Tests.IndexModel
@{
    ViewData["Title"] = "All tests";
}
<h1>All tests</h1>
@if (!Model.Tests.Any())
{
    <p>No tests synced yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tester</th>
                <th>Farm</th>
                <th>Created</th>
                <th>Completed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Tests)
            {
                <tr>
                    <td>@t.Tester?.UserName</td>
                    <td>@t.Farm?.Name</td>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(t.MarkedCompleteAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}
