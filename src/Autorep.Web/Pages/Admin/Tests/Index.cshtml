@page
@model Autorep.Web.Pages.Admin.Tests.IndexModel
@using Autorep.Web.Domain
@using Autorep.Web.Pages.Admin.Tests
@{
    ViewData["Title"] = "All tests";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>@(Model.FarmName ?? "All tests")</h1>
        <p>
            @Model.TotalCount machine test@(Model.TotalCount == 1 ? "" : "s")
            @(Model.FarmName is null ? "synced from the field." : "for this farm.")
        </p>
    </div>
    @if (Model.FarmName is not null)
    {
        <div class="page-header__actions">
            <a class="btn btn--secondary" asp-page="/Admin/Tests/Index">View all tests</a>
        </div>
    }
</div>

@* Filtered on the server over the paginated query (AdminTestQuery). Each active filter shows as a
   chip whose × removes just that one. *@
<form method="get" class="list-filters" id="test-filters">
    @if (Model.FarmId is not null)
    {
        <input type="hidden" name="farmId" value="@Model.FarmId" />
    }
    <input type="search" name="q" value="@Model.Q" aria-label="Search by farm or tester"
           placeholder="@(Model.FarmName is null ? "Farm, supply number or tester…" : "Search this farm by tester…")" />
    @if (Model.CompanyOptions.Any())
    {
        <select name="companyId" onchange="if (this.form.testerId) this.form.testerId.value = ''; this.form.submit()" aria-label="Filter by company">
            <option value="">All companies</option>
            @foreach (var o in Model.CompanyOptions)
            {
                <option value="@o.Value" selected="@o.Selected">@o.Text</option>
            }
        </select>
    }
    <select name="testerId" onchange="this.form.submit()" aria-label="Filter by tester">
        <option value="">All testers</option>
        @foreach (var o in Model.TesterOptions)
        {
            <option value="@o.Value" selected="@o.Selected">@o.Text</option>
        }
    </select>
    <label class="list-filters__date">
        <span>Tested from</span>
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </label>
    <label class="list-filters__date">
        <span>to</span>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </label>
    <select name="status" onchange="this.form.submit()" aria-label="Filter by status">
        <option value="">Any status</option>
        <option value="@AdminTestQuery.Complete" selected="@(Model.Status == AdminTestQuery.Complete)">Complete</option>
        <option value="@AdminTestQuery.InProgress" selected="@(Model.Status == AdminTestQuery.InProgress)">In progress</option>
    </select>
    <label class="form-check" style="margin:0">
        <input type="checkbox" name="hasConflicts" value="true" checked="@Model.HasConflicts" onchange="this.form.submit()" />
        <span>Has conflicts</span>
    </label>
    <label class="form-check" style="margin:0">
        <input type="checkbox" name="showDeleted" value="true" checked="@Model.ShowDeleted" onchange="this.form.submit()" />
        <span>Show deleted</span>
    </label>
    <button type="submit" class="btn btn--secondary">Search</button>
</form>

@if (Model.Chips.Any())
{
    <div class="filter-chips" aria-label="Active filters">
        @foreach (var (label, param) in Model.Chips)
        {
            <a class="filter-chip" asp-page="/Admin/Tests/Index" asp-all-route-data="@Model.RouteWith(without: param)"
               title="Remove this filter">
                @label <span class="filter-chip__x" aria-hidden="true">×</span><span class="visually-hidden">(remove)</span>
            </a>
        }
        @if (Model.Chips.Count > 1)
        {
            <a class="filter-chips__clear" asp-page="/Admin/Tests/Index">Clear all</a>
        }
    </div>
}

@if (!Model.Tests.Any())
{
    <div class="empty">
        <div class="empty__title">
            @(Model.HasFilter ? "No matching tests"
                : Model.FarmName is not null ? "No tests for this farm yet"
                : "No tests synced yet")
        </div>
        <p class="empty__text">
            @(Model.HasFilter ? "Try a different search term or filter."
                : Model.FarmName is not null ? "Tests will appear here once this farm has synced machine tests."
                : "Tests will appear here as Testers complete and sync them.")
        </p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Tester</th>
                    <th>Farm</th>
                    <th>Tested</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tests)
                {
                    <tr>
                        <td>@(string.IsNullOrEmpty(t.Tester?.DisplayName) ? t.Tester?.UserName : t.Tester.DisplayName)</td>
                        <td>@t.Farm?.Name</td>
                        <td class="td-muted">
                            @if (t.MarkedCompleteAt is { } done)
                            {
                                @done.ToNz().ToString("dd MMM yyyy, HH:mm")
                            }
                            else
                            {
                                <text>Started @t.CreatedAt.ToNz().ToString("dd MMM yyyy, HH:mm")</text>
                            }
                        </td>
                        <td>
                            @if (t.MarkedCompleteAt is null)
                            {
                                <span class="badge">In progress</span>
                            }
                            else
                            {
                                <span class="badge badge--success">Complete</span>
                            }
                            @if (t.Version > 1)
                            {
                                <span class="badge" title="Earlier versions are in its history">v@(t.Version)</span>
                            }
                            @if (t.AuthorId is not null)
                            {
                                <span class="badge">Edited by admin</span>
                            }
                            @if (Model.ConflictedIds.Contains(t.Id))
                            {
                                <span class="badge badge--warning" title="Two versions of this test replaced the same one; see its history">Conflict</span>
                            }
                            @if (t.IsDeleted)
                            {
                                <span class="badge badge--danger" title="@t.DeletedReason">Deleted</span>
                            }
                        </td>
                        <td><a class="btn btn--secondary btn--sm" href="/Admin/Tests/View/@t.Id">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-4)">
        @if (Model.PageNumber > 1)
        {
            <a class="btn btn--secondary btn--sm" asp-page="/Admin/Tests/Index" asp-all-route-data="@Model.RouteWith(page: Model.PageNumber - 1)">‹ Prev</a>
        }
        <span class="td-muted">Page @Model.PageNumber of @Model.TotalPages · @Model.TotalCount total</span>
        @if (Model.PageNumber < Model.TotalPages)
        {
            <a class="btn btn--secondary btn--sm" asp-page="/Admin/Tests/Index" asp-all-route-data="@Model.RouteWith(page: Model.PageNumber + 1)">Next ›</a>
        }
    </div>
}
