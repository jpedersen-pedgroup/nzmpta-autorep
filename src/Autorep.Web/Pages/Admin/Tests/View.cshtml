@page "{id:guid}"
@model Autorep.Web.Pages.Admin.Tests.ViewModel
@{
    ViewData["Title"] = "View test";
}

@* Admin read-only view: the offline wizard bundle (autorep.js) sees data-server-test and fetches
   the test from /api/tests/{id} instead of IndexedDB, rendering it read-only. *@
<div id="wizard-root" data-server-test="@Model.Id"></div>

@section Scripts {
    <script type="module" src="~/js/dist/autorep.js" asp-append-version="true"></script>
}
