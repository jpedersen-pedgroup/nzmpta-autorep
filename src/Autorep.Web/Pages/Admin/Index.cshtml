@page
@model Autorep.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin home";
}

<section class="welcome">
    <h1>Admin Portal</h1>
    <p>Manage testers, testing companies, and synced machine tests.</p>
</section>

<div class="tile-grid">
    <a class="tile" asp-page="/Admin/Tests/Index">
        <div class="tile__icon">≡</div>
        <div class="tile__title">All tests</div>
        <div class="tile__desc">Browse every machine test synced from the field.</div>
    </a>
    <a class="tile" asp-page="/Admin/Testers/Index">
        <div class="tile__icon">⚇</div>
        <div class="tile__title">Testers</div>
        <div class="tile__desc">Manage tester accounts, roles, and licences.</div>
    </a>
    <a class="tile" asp-page="/Admin/Companies/Index">
        <div class="tile__icon">▣</div>
        <div class="tile__title">Testing companies</div>
        <div class="tile__desc">Create and manage the companies that employ testers.</div>
    </a>
    <a class="tile" asp-page="/Admin/Standards/Index">
        <div class="tile__icon">≑</div>
        <div class="tile__title">Test standards</div>
        <div class="tile__desc">Edit the pass/fail thresholds; changes sync to testers' devices.</div>
    </a>
</div>
