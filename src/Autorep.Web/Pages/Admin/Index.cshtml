@page
@model Autorep.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin home";
}

<section class="welcome">
    <h1>Admin Portal</h1>
    <p>Browse synced tests across all Testing Companies.</p>
</section>

<div class="tile-grid">
