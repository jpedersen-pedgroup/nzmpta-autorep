@page
@model Autorep.Web.Pages.Admin.Farms.IndexModel
@{
    ViewData["Title"] = "Farms";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>Farms</h1>
        <p>
            @if (Model.ScopedView)
            { <span>Farms your company has set up or tested.</span> }
            else
            { <span>All farms across every testing company.</span> }
        </p>
    </div>
</div>

@if (Model.PendingReviewCount > 0)
{
    <div class="alert alert--warning">
        <strong>@Model.PendingReviewCount farm@(Model.PendingReviewCount == 1 ? "" : "s") awaiting review</strong>
        — added by testers in the field. They're listed first below: check the details, then approve from the farm's Edit page.
    </div>
}

@if (!Model.Farms.Any())
{
    <div class="empty">
        <div class="empty__title">No farms yet</div>
        <p class="empty__text">Farms appear here once tests have been created against them.</p>
    </div>
}
else
{
    <div class="list-search">
        <input type="search" data-table-filter="farms-table" placeholder="Search farms…" aria-label="Search farms" />
    </div>
    <div class="table-wrap table-wrap--scroll">
        <table class="table" id="farms-table">
            <thead>
                <tr><th>Name</th><th>Region</th><th>Milk company</th><th>Town</th><th>Status</th><th>Tests</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Farms)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td class="td-muted">@(f.Region ?? "—")</td>
                        <td class="td-muted">@(f.MilkCompany ?? "—")</td>
                        <td class="td-muted">@(f.Town ?? "—")</td>
                        <td>
                            @if (f.PendingReviewSince is not null) { <span class="badge badge--warning">Under review</span> }
                            else if (f.IsActive) { <span class="badge badge--success">Active</span> }
                            else { <span class="badge">Inactive</span> }
                        </td>
                        <td>@f.TestCount</td>
                        <td><a class="btn btn--secondary" asp-page="/Admin/Farms/Edit" asp-route-id="@f.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="empty" data-table-empty="farms-table" hidden>
        <div class="empty__title">No matching farms</div>
        <p class="empty__text">Try a different search term.</p>
    </div>
}
