@page "{id:guid}"
@model Autorep.Web.Pages.Admin.Farms.EditModel
@{
    ViewData["Title"] = $"Edit {Model.FarmName}";
}

<div class="page-header">
    <div class="page-header__heading">
        <h1>@Model.FarmName</h1>
        <p>
            @Model.TestCount test(s)
            @if (Model.UpdatedAt is not null) { <span>· last edited @Model.UpdatedAt.Value.ToString("dd MMM yyyy")</span> }
        </p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--secondary" asp-page="/Admin/Farms/Index">Back</a>
    </div>
</div>

@if (Model.Message is not null) { <div class="alert alert--success">@Model.Message</div> }
@if (Model.Errors.Any())
{
    <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}

<form method="post">
    <div class="card" style="max-width:760px">
        <h2 class="card__title">Identity</h2>
        <div class="form-field">
            <label asp-for="Input.Name">Farm name</label>
            <input asp-for="Input.Name" required />
        </div>
        <div class="form-field">
            <label asp-for="Input.SupplyNumber">Supply number</label>
            <input asp-for="Input.SupplyNumber" />
        </div>
        <div class="form-field">
            <label asp-for="Input.MilkSupplyCompanyId">Milk supply company</label>
            <select asp-for="Input.MilkSupplyCompanyId" asp-items="Model.MilkCompanyOptions">
                <option value="">— Not set —</option>
            </select>
        </div>
    </div>

    <div class="card" style="max-width:760px">
        <h2 class="card__title">Location</h2>
        <div class="form-field">
            <label asp-for="Input.AddressLine1">Address line 1</label>
            <input asp-for="Input.AddressLine1" />
        </div>
        <div class="form-field">
            <label asp-for="Input.AddressLine2">Address line 2</label>
            <input asp-for="Input.AddressLine2" />
        </div>
        <div class="form-field">
            <label asp-for="Input.Town">Town / locality</label>
            <input asp-for="Input.Town" />
        </div>
        <div class="form-field">
            <label asp-for="Input.RegionId">Region</label>
            <select asp-for="Input.RegionId" asp-items="Model.RegionOptions">
                <option value="">— Not set —</option>
            </select>
        </div>
        <div class="form-field">
            <label asp-for="Input.PostCode">Post code</label>
            <input asp-for="Input.PostCode" />
        </div>
        <div class="form-field">
            <label asp-for="Input.RapidNumber">RAPID number</label>
            <input asp-for="Input.RapidNumber" />
        </div>
    </div>

    <div class="card" style="max-width:760px">
        <h2 class="card__title">Farmer contact</h2>
        <div class="form-field">
            <label asp-for="Input.FarmerName">Farmer name</label>
            <input asp-for="Input.FarmerName" />
        </div>
        <div class="form-field">
            <label asp-for="Input.ContactPhone">Phone</label>
            <input asp-for="Input.ContactPhone" />
        </div>
        <div class="form-field">
            <label asp-for="Input.ContactEmail">Email</label>
            <input asp-for="Input.ContactEmail" type="email" />
        </div>
    </div>

    <div class="card" style="max-width:760px">
        <h2 class="card__title">Notes &amp; status</h2>
        <div class="form-field">
            <label asp-for="Input.Notes">Notes</label>
            <textarea asp-for="Input.Notes" rows="3"></textarea>
        </div>
        <div class="form-field form-field--inline">
            <label><input asp-for="Input.IsActive" type="checkbox" /> Active</label>
        </div>
        <div class="form-actions"><button type="submit" class="btn">Save farm details</button></div>
    </div>
</form>
