@page
@model Autorep.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set new password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set new password · NZMPTA AutoRep</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-layout">
    <div class="auth-card">
        <div class="auth-card__logo"><span class="auth-card__logo-mark">AR</span></div>
        @if (Model.Success)
        {
            <h1 class="auth-card__title">Password updated</h1>
            <p class="auth-card__subtitle">You can now sign in with your new password.</p>
            <a class="btn btn--full" asp-page="/Account/Login">Sign in</a>
        }
        else
        {
            <h1 class="auth-card__title">Set a new password</h1>
            <p class="auth-card__subtitle">Choose a password — 12+ chars with upper, lower and a digit.</p>
            <form method="post">
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Token" />
                <div class="form-field">
                    <label asp-for="Input.Password">New password</label>
                    <input asp-for="Input.Password" type="password" required autofocus autocomplete="new-password" />
                </div>
                <div class="form-field">
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" required autocomplete="new-password" />
                </div>
                @if (Model.Errors.Any())
                {
                    <div class="alert alert--danger"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
                }
                <button type="submit" class="btn btn--full">Set password</button>
            </form>
        }
    </div>
</body>
</html>
