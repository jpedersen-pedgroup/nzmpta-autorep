@page
@model Autorep.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot password · NZMPTA AutoRep</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-layout">
    <div class="auth-card">
        <div class="auth-card__logo"><span class="auth-card__logo-mark">AR</span></div>
        @if (Model.Sent)
        {
            <h1 class="auth-card__title">Check your email</h1>
            <p class="auth-card__subtitle">If an account exists for that address, we've sent a link to reset your password.</p>
            <a class="btn btn--secondary btn--full" asp-page="/Account/Login">Back to sign in</a>
        }
        else
        {
            <h1 class="auth-card__title">Forgot password</h1>
            <p class="auth-card__subtitle">We'll email you a link to set a new one.</p>
            <form method="post">
                <div class="form-field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" required autofocus />
                </div>
                <button type="submit" class="btn btn--full">Send reset link</button>
            </form>
            <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem">
                <a asp-page="/Account/Login" style="color:var(--text-muted)">Back to sign in</a>
            </p>
        }
    </div>
</body>
</html>
