@page
@model Autorep.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<form method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Input.Email" type="email" class="form-control" required autocomplete="username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input asp-for="Input.Password" type="password" class="form-control" required autocomplete="current-password" />
    </div>
    <div class="form-check mb-3">
        <input type="checkbox" asp-for="Input.RememberMe" class="form-check-input" />
        <label class="form-check-label">Remember me</label>
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
@if (Model.ErrorMessage is not null)
{
    <p class="text-danger mt-3">@Model.ErrorMessage</p>
}
