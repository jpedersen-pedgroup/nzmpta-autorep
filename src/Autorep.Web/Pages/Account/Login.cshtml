@page
@model Autorep.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in · NZMPTA AutoRep</title>
    <partial name="_BrandHead" />
</head>
<body class="auth-layout">
    <div class="auth-card">
        <div class="auth-card__logo">
            <img class="auth-card__logo-img auth-card__logo-img--lockup" src="~/img/logo-mpnz-lockup.svg" alt="MPNZ — Milking & Pumping since 1932" />
        </div>
        <h1 class="auth-card__title auth-card__title--solo">Sign in to AutoRep</h1>

        <form method="post">
            <div class="form-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" required autocomplete="username" autofocus />
            </div>
            <div class="form-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" required autocomplete="current-password" />
            </div>
            <div class="form-check">
                <input type="checkbox" asp-for="Input.RememberMe" id="remember-me" />
                <label for="remember-me">Keep me signed in on this device</label>
            </div>
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert--danger">@Model.ErrorMessage</div>
            }
            <button type="submit" class="btn btn--full">Sign in</button>
        </form>
        <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem">
            <a asp-page="/Account/ForgotPassword" style="color:var(--text-muted)">Forgot your password?</a>
        </p>
    </div>
    <script src="~/js/pwa-register.js"></script>
</body>
</html>
