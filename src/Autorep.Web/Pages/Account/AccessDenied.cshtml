@page
@{
    ViewData["Title"] = "Access denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access denied · NZMPTA AutoRep</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-layout">
    <div class="auth-card">
        <div class="auth-card__logo">
            <span class="auth-card__logo-mark">AR</span>
        </div>
        <h1 class="auth-card__title">Access denied</h1>
        <p class="auth-card__subtitle">Your account doesn't have permission to view that page.</p>
        <form method="post" asp-page="/Account/Logout">
            <button type="submit" class="btn btn--secondary btn--full">Sign out</button>
        </form>
    </div>
</body>
</html>
